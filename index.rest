###
@BASE_URL = http://localhost

///Lista un usuario específico segun el parametro enviado en el body de la solicitud. 
///El resultado es un arreglo con un solo objeto, el cual contiene los datos del usuario solicitado. 
///Si el usuario no existe, el arreglo estará vacío.
###
POST {{ BASE_URL }}/Servicio1/listar HTTP/1.1
Authorization: Bearer {{ AUTH_TOKEN }}
Content-Type: application/json
Origin: {{ BASE_URL }}

{
  "Usuario": "beatriz.pérez1"
}

